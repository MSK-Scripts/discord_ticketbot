{
  "name": "discord-ticketbot",
  "version": "2.10.0",
  "description": "A feature-rich, self-hosted Discord ticket bot built with Discord.js v14 and SQLite.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dashboard": "node dashboard.js",
    "dashboard:setup": "node scripts/dashboard-setup.js",
    "db:migrate": "node scripts/migrate-db.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "mysql2": "^3.23.1",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "overrides": {
    "undici": "^6.27.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
