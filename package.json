{
  "name": "discord-ticketbot",
  "version": "2.17.0",
  "description": "A feature-rich, self-hosted Discord ticket bot built with Discord.js v14 and SQLite.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dashboard": "node dashboard.js",
    "dashboard:setup": "node scripts/dashboard-setup.js",
    "db:migrate": "node scripts/migrate-db.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0"
  },
  "optionalDependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "license": "AGPL-3.0-only"
}
