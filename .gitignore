# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
/build

# Graphify
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Production
/dist

# Dashboard UI (web/)
# NOTE: web/dist is deliberately NOT ignored — the built UI is committed so a
# self-hoster never has to run a build step on their server. Only the sources'
# dependencies are ignored.
web/node_modules

# Environment Files
.env
.env*.local
.env.production
.env.development

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

