# Discord Ticket Bot
# Copy this file to .env and fill in your values

# ── Database (optional) ───────────────────────────────────────────────────────
# Leave DATABASE_URL unset/empty to use the bundled SQLite file (data/tickets.db).
# This is the default and needs no extra setup.
#
# To use an external database instead, set DATABASE_URL to one of:
#   MySQL/MariaDB:  mysql://user:password@host:3306/ticketbot
#   PostgreSQL:     postgres://user:password@host:5432/ticketbot
#   SQLite (path):  sqlite:./data/tickets.db
#
# Append ?ssl=true (or ?sslmode=require) for managed databases that require TLS.
# To copy an existing SQLite database into the new backend, run:  npm run db:migrate
# DATABASE_URL=""

# Your Discord bot token (from https://discord.com/developers/applications)
TOKEN="YOUR_BOT_TOKEN_HERE"

# Your Discord application/client ID
CLIENT_ID="YOUR_CLIENT_ID_HERE"

# Your Discord server (guild) ID
GUILD_ID="YOUR_GUILD_ID_HERE"

# ── MSK Transcript Service ────────────────────────────────────────────────────
# API key from msk-scripts.de – required for transcript links.
# Get yours at: https://msk-scripts.de/verify
MSK_API_KEY="YOUR_MSK_API_KEY_HERE"

# Base URL of the MSK API (do not change unless self-hosting the website)
MSK_API_URL="https://www.msk-scripts.de"

# ── Web Dashboard (optional) ──────────────────────────────────────────────────
# Manage tickets, stats and the bot config in your browser instead of editing
# files by hand. Run the guided setup instead of filling this in manually:
#
#     npm run dashboard:setup
#
# Then start the bot WITH the dashboard using:  npm run dashboard
# (`npm start` keeps running the plain bot, without any web server.)

# Off by default. The dashboard can restart the bot and edit this .env, so it is
# strictly opt-in.
DASHBOARD_ENABLED="false"

# Bind address. Keep 127.0.0.1: the dashboard is then NOT reachable from the
# internet, and your reverse proxy still talks to it locally. Only change this
# if you know exactly why.
DASHBOARD_HOST="127.0.0.1"
DASHBOARD_PORT="3010"

# The URL your browser uses. Behind a reverse proxy this is your public https
# address — NOT the bind address above. It must match the Discord redirect URI.
DASHBOARD_PUBLIC_URL="http://127.0.0.1:3010"

# The bot refuses to start if it is bound to a public interface without https.
# Only set this if you terminate TLS somewhere it cannot see.
# DASHBOARD_ALLOW_INSECURE="false"

# Signing key for session cookies. Generated automatically on first start and
# written here — never share it, and never reuse one across installations.
SESSION_SECRET=""

# Discord OAuth2 client secret (Developer Portal → OAuth2 → Client Secret).
# Required for the dashboard login. Also add this redirect URI in the portal:
# Example: http://127.0.0.1:3010/auth/callback
#
#     <DASHBOARD_PUBLIC_URL>/auth/callback
#
CLIENT_SECRET=""
